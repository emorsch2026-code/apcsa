            writer.println("  Scissors beats  Paper");
            writer.println("  Paper    beats  Rock");
            writer.println("  Same move = Tie (the round is replayed, it does not count)");
            writer.println();
            writer.println("HOW TO ENTER YOUR MOVE");
            writer.println("----------------------");
            writer.println("  Type 1 and press Enter -> Rock");
            writer.println("  Type 2 and press Enter -> Paper");
            writer.println("  Type 3 and press Enter -> Scissors");
            writer.println("  Any other input defaults to Rock.");
            writer.println();
            writer.println("SCORING");
            writer.println("-------");
            writer.println("  - Your win/loss record is saved between sessions.");
            writer.println("  - Series wins and losses are tracked separately from round wins.");
            writer.println("  - Your current series streak and your all-time best streak are saved.");
