// Plays a .wav sound file after a short delay (same pattern as teacher's PlaySound example)
class SoundClass {
    private String filePath;

    public SoundClass(String filePath) {
        this.filePath = filePath;
    }

    // Syntax for playing sounds - do not change this!
    public static void playSound(String filePath) {
        try {
            File soundFile = new File(filePath);
            AudioInputStream audioIn = AudioSystem.getAudioInputStream(soundFile);
            Clip clip = AudioSystem.getClip();
            clip.open(audioIn);
            clip.setFramePosition(0);
            clip.start();
            // Give the clip time to finish before the program moves on
            clip.addLineListener(event -> {
                if (event.getType() == LineEvent.Type.STOP) {
                    clip.close();
                }
            });
        } catch (UnsupportedAudioFileException | IOException | LineUnavailableException e) {
            System.out.println("Could not play sound: " + filePath);
        }
    }

    // You must create some time for the sound, or it will be played in 0 seconds
    public void createTimeForSound() {
        String path = this.filePath;
        TimerTask task = new TimerTask() {
            public void run() {
                playSound(path);
            }
        };
        Timer timer = new Timer("Timer");
        long delay = 500L; // half a second is enough for in-game feedback
        timer.schedule(task, delay);
    }
}

// Stores the player's name, win/loss record, and series streak data.
// selectAction() gets input from human or picks randomly for the computer.
class Player {
    private String name;
    private boolean isComputer;
    private int wins;
    private int losses;
    private int currentStreak; // consecutive series wins
    private int bestStreak;    // all-time best series streak for this player

    public Player(String name, boolean isComputer) {
        this.name = name;
        this.isComputer = isComputer;
        this.wins = 0;
        this.losses = 0;
        this.currentStreak = 0;
        this.bestStreak = 0;
    }

    // Returns "Rock", "Paper", or "Scissors"
    public String selectAction(Scanner scanner) {
        if (isComputer) {
            String[] choices = {"Rock", "Paper", "Scissors"};
            Random rand = new Random();
            return choices[rand.nextInt(3)];
        }
        System.out.println("Pick your move:  1) Rock   2) Paper   3) Scissors");
        System.out.print("Your choice: ");
        String input = scanner.nextLine().trim();

        if (input.equals("1")) return "Rock";
        if (input.equals("2")) return "Paper";
        if (input.equals("3")) return "Scissors";

        System.out.println("(Invalid input — defaulting to Rock)");
        return "Rock";
    }

    // Called after winning a series — increments streak and updates best if needed
    // Returns true if a new best streak was just set
    public boolean recordSeriesWin() {
        wins++;
        currentStreak++;
        if (currentStreak > bestStreak) {
            bestStreak = currentStreak;
            return true; // new personal best
        }
        return false;
    }

    // Called after losing a series — resets streak
    public void recordSeriesLoss() {
        losses++;
        currentStreak = 0;
    }

    // Getters
    public String getName()         { return name; }
    public int getWins()            { return wins; }
    public int getLosses()          { return losses; }
    public int getCurrentStreak()   { return currentStreak; }
    public int getBestStreak()      { return bestStreak; }

    // Setters: used by FileManager when loading saved data
    public void setWins(int w)            { this.wins = w; }
    public void setLosses(int l)          { this.losses = l; }
    public void setCurrentStreak(int s)   { this.currentStreak = s; }
    public void setBestStreak(int s)      { this.bestStreak = s; }
}

class FileManager {
    private static final String STATS_FILE        = "folder/player_stats.txt"; // FILE 1
    private static final String HISTORY_FILE      = "folder/game_history.txt"; // FILE 2
    private static final String SCORES_FILE       = "folder/scores.txt";       // FILE 3
    private static final String INSTRUCTIONS_FILE = "folder/how_to_play.txt";  // FILE 4

